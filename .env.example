HTTP_PORT=3000
HTTP_HOST=127.0.0.1
LOCAL_GRPC_PORT=50051
LOCAL_GRPC_HOST=127.0.0.1
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# UI-TARS local GUI automation
UI_TARS_ENABLE_LIVE=false
UI_TARS_BASE_URL=http://127.0.0.1:8000/v1
UI_TARS_API_KEY=local-ui-tars-key
UI_TARS_MODEL=ui-tars
UI_TARS_MAX_LOOPS=8
UI_TARS_INSTRUCTION=Open the local app and verify the prompt form is visible.

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_HISTORY_LIMIT=8
TELEGRAM_CHAT_SYSTEM_PROMPT=You are a helpful, friendly assistant chatting in Telegram. Keep replies concise unless the user asks for detail.
